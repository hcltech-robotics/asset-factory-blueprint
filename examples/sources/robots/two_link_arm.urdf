<?xml version="1.0"?>
<robot name="six_axis_pick_arm">
  <material name="arm_grey">
    <color rgba="0.35 0.37 0.40 1"/>
  </material>
  <material name="gripper_dark">
    <color rgba="0.12 0.13 0.15 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.0496" ixy="0" ixz="0" iyy="0.0496" iyz="0" izz="0.0600"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.10" length="0.14"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.10" length="0.14"/></geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="0.0135375" ixy="0" ixz="0" iyy="0.0135375" iyz="0" izz="0.012675"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="0.12"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="0.12"/></geometry>
    </collision>
  </link>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0.16 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0050625" ixy="0" ixz="0" iyy="0.0451979167" iyz="0" izz="0.0451979167"/>
    </inertial>
    <visual>
      <origin xyz="0.16 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.045" length="0.32"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <origin xyz="0.16 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.045" length="0.32"/></geometry>
    </collision>
  </link>

  <link name="forearm_link">
    <inertial>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0242666667" iyz="0" izz="0.0242666667"/>
    </inertial>
    <visual>
      <origin xyz="0.14 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.04" length="0.28"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <origin xyz="0.14 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.04" length="0.28"/></geometry>
    </collision>
  </link>

  <link name="wrist_1_link">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="1.4"/>
      <inertia ixx="0.00112" ixy="0" ixz="0" iyy="0.0017266667" iyz="0" izz="0.0017266667"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
    </collision>
  </link>

  <link name="wrist_2_link">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="1.1"/>
      <inertia ixx="0.00067375" ixy="0" ixz="0" iyy="0.0012535417" iyz="0" izz="0.0012535417"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.035" length="0.10"/></geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.035" length="0.10"/></geometry>
    </collision>
  </link>

  <link name="gripper">
    <inertial>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00292" ixy="0" ixz="0" iyy="0.00100" iyz="0" izz="0.00320"/>
    </inertial>
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.16 0.06"/></geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.16 0.06"/></geometry>
    </collision>
  </link>

  <link name="left_finger">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.000016875" ixy="0" ixz="0" iyy="0.0001635" iyz="0" izz="0.000153375"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.015 0.03"/></geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.015 0.03"/></geometry>
    </collision>
  </link>

  <link name="right_finger">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.000016875" ixy="0" ixz="0" iyy="0.0001635" iyz="0" izz="0.000153375"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.015 0.03"/></geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.015 0.03"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9670597" upper="2.9670597" effort="120.0" velocity="2.0"/>
    <dynamics damping="0.20" friction="0.05"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0943951" upper="2.0943951" effort="120.0" velocity="2.0"/>
    <dynamics damping="0.20" friction="0.05"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <origin xyz="0.32 0 0" rpy="0 0 0"/>
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6179939" upper="2.6179939" effort="100.0" velocity="2.2"/>
    <dynamics damping="0.16" friction="0.04"/>
  </joint>

  <joint name="wrist_roll_joint" type="revolute">
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1415927" upper="3.1415927" effort="40.0" velocity="3.0"/>
    <dynamics damping="0.08" friction="0.02"/>
  </joint>

  <joint name="wrist_pitch_joint" type="revolute">
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0943951" upper="2.0943951" effort="40.0" velocity="3.0"/>
    <dynamics damping="0.08" friction="0.02"/>
  </joint>

  <joint name="wrist_yaw_joint" type="revolute">
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
    <parent link="wrist_2_link"/>
    <child link="gripper"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415927" upper="3.1415927" effort="40.0" velocity="3.0"/>
    <dynamics damping="0.08" friction="0.02"/>
  </joint>

  <joint name="left_finger_joint" type="prismatic">
    <origin xyz="0.08 0.0175 0" rpy="0 0 0"/>
    <parent link="gripper"/>
    <child link="left_finger"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.06" effort="30.0" velocity="0.25"/>
    <dynamics damping="0.04" friction="0.01"/>
  </joint>

  <joint name="right_finger_joint" type="prismatic">
    <origin xyz="0.08 -0.0175 0" rpy="0 0 0"/>
    <parent link="gripper"/>
    <child link="right_finger"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.06" effort="30.0" velocity="0.25"/>
    <dynamics damping="0.04" friction="0.01"/>
  </joint>
</robot>
